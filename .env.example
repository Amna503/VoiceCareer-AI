# VoiceCareer AI — environment template
#
# The server reads backend/.env. Copy that file, not this one:
#
#   cp .env.example backend/.env      (macOS / Linux)
#   Copy-Item .env.example backend\.env   (PowerShell)
#
# NEVER put real keys in this file, and never in frontend/. The browser only
# ever receives a short-lived AssemblyAI token minted by the backend.

# ── AssemblyAI (backend only) ────────────────────────────────────────────────
# Required. Used for the Voice Agent token, the v3 live-streaming token, and
# file-based transcription.
ASSEMBLYAI_API_KEY=

# ── LLM (OpenAI-compatible: Groq, OpenAI, together, ...) ────────────────────
# Required. Drives career discovery, the interviewer, evaluation, skill gaps
# and roadmap enrichment.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# ── TTS (used by the /api/voice and /api/career push-to-talk flows) ─────────
# The Voice Agent interview speaks with its own voice; these are for the
# legacy push-to-talk and career-coach endpoints.
TTS_MODEL=canopylabs/orpheus-v1-english
TTS_VOICE=hannah
TTS_ENABLED=true

# ── Voice Agent tuning (optional — defaults are baked into the code) ────────
# Voice Career AI interviewer voice
VOICE_AGENT_VOICE=alba
# How long the browser has to redeem the token (1-600s)
VOICE_AGENT_TOKEN_TTL=300
# Cap on one interview session (60-10800s)
VOICE_AGENT_MAX_SESSION_SECONDS=1800

# ── Server ──────────────────────────────────────────────────────────────────
# Leave unset locally. Railway injects PORT itself, so this line is only for
# local development.
PORT=3000

# ── Production (Railway) ────────────────────────────────────────────────────
# Set in the Railway dashboard, never in a committed file.
# NODE_ENV=production
#
# Comma-separated browser origins allowed to call the API. Leave empty to allow
# any origin, which is convenient while the Vercel domain is still unknown. Once
# the frontend is deployed, set it to that domain to lock CORS down:
# ALLOWED_ORIGINS=https://your-app.vercel.app
