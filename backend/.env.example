# AssemblyAI — used by the backend only. Never exposed to the browser.
# Voice Agent flow: GET https://agents.assemblyai.com/v1/token
ASSEMBLYAI_API_KEY=

# LLM (OpenAI-compatible) — used by ai/agents, ai/evaluation, ai/career-engine
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# TTS for the legacy push-to-talk / coach flow
TTS_MODEL=canopylabs/orpheus-v1-english
TTS_VOICE=hannah
TTS_ENABLED=true

# Voice Agent (optional overrides — sane defaults are baked into the code)
# Voice Career AI interviewer voice
VOICE_AGENT_VOICE=alba
# How long the browser has to open the WebSocket with the token (1-600s)
VOICE_AGENT_TOKEN_TTL=300
# Cap on one interview session (60-10800s)
VOICE_AGENT_MAX_SESSION_SECONDS=1800

PORT=3000
